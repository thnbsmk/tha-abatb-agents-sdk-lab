# Application API key (keep outside the self-hosted environment).
# Required permissions: api.agents.read, api.agents.write, api.responses.write
OPENAI_API_KEY=your_application_api_key

# Restricted environment key for codex exec-server inside the workspace.
# Required permission: api.agents.environments.connect (all others: None)
OPENAI_ENVIRONMENT_KEY=your_restricted_environment_key

# OpenAI project that owns the saved agent definition.
OPENAI_PROJECT_ID=proj_Kbc70ouR70glbq4U3fvrhBTp

# Saved agent definition reused for each investigation session.
AGENT_ID=agent_5ff88ea0ea894e468128481c5e08c233c55b20d741264d78b8

# Self-hosted workspace path exposed to the agent.
WORKSPACE_DIRECTORY=/workspace/agensdk

# Optional: path to the Codex CLI binary.
# CODEX_BIN=/workspace/.codex-cli/node_modules/.bin/codex
