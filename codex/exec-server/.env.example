# Restricted environment key (api.agents.environments.connect only).
OPENAI_ENVIRONMENT_KEY=your_restricted_environment_key

# Workspace the agent can read/run commands in.
WORKSPACE_DIRECTORY=/workspace/agensdk

# Optional override for Codex CLI path.
# CODEX_BIN=/workspace/.codex-cli/node_modules/.bin/codex

# Session-specific values from ChatGPT / Agents API (change every session).
REMOTE_URL=https://api.openai.com/v1/agents/api/connect/rt_example
ENVIRONMENT_ID=ccarenv_example
